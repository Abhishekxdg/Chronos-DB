{
  "name": "@chronosdb/client",
  "version": "0.2.0",
  "description": "TypeScript/JavaScript client for Chronos DB's HTTP API: worlds (copy-on-write branches of the whole database), rows, search, diff and merge. One file, no dependencies.",
  "license": "MIT",
  "author": "Abhishek DG",
  "homepage": "https://abhishekxdg.github.io/Chronos-DB/reference/clients",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhishekxdg/chronosdb.git",
    "directory": "clients/typescript"
  },
  "bugs": "https://github.com/Abhishekxdg/chronosdb/issues",
  "keywords": [
    "chronos",
    "chronosdb",
    "database",
    "ai-agents",
    "branching",
    "postgres",
    "vector-search"
  ],
  "type": "module",
  "main": "./dist/chronos.js",
  "types": "./dist/chronos.d.ts",
  "exports": {
    ".": {
      "types": "./dist/chronos.d.ts",
      "import": "./dist/chronos.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
